generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  username         String            @unique
  password         String
  status           String            @default("A") @db.VarChar(50)
  employeeId       Int
  roleId           Int
  createdAt        DateTime          @default(now()) @db.Timestamptz(0)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(0)
  assignments      Assignment[]
  brands           Brand[]
  categories       Category[]
  chats            Chat[]
  eliminates       Eliminate[]
  helpdeskRequests HelpdeskRequest[]
  tickets          Ticket[]
  typeDevices      TypeDevice[]
  employee         Employee          @relation(fields: [employeeId], references: [id])
  role             Role              @relation(fields: [roleId], references: [id])
  notifications    Notification[]
}

model Employee {
  id           Int         @id
  first_name   String      @db.VarChar(255)
  last_name    String      @db.VarChar(255)
  emp_code     String      @unique @db.VarChar(255)
  status       String      @default("A") @db.VarChar(50)
  gender       String?     @db.VarChar(255)
  tel          String?     @db.VarChar(255)
  email        String?     @db.VarChar(255)
  empimg       String?     @db.VarChar(255)
  posId        Int?
  departmentId Int?
  divisionId   Int?
  officeId     Int?
  unitId       Int?
  createdAt    DateTime    @default(now()) @db.Timestamptz(0)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(0)
  department   Department? @relation(fields: [departmentId], references: [id])
  division     Division?   @relation(fields: [divisionId], references: [id])
  office       Office?     @relation(fields: [officeId], references: [id])
  position     Position?   @relation(fields: [posId], references: [id])
  unit         Unit?       @relation(fields: [unitId], references: [id])
  user         User[]
}

model Department {
  id                Int            @id
  department_name   String?        @db.VarChar(255)
  department_code   String?        @db.VarChar(50)
  department_status String         @default("A") @db.VarChar(50)
  divisions         Division[]
  employees         Employee[]
  headCategories    HeadCategory[]
}

model Division {
  id              Int            @id
  division_name   String?        @db.VarChar(255)
  division_code   String?        @db.VarChar(50)
  division_status String         @default("A") @db.VarChar(50)
  branch_id       Int?
  departmentId    Int
  department      Department     @relation(fields: [departmentId], references: [id])
  employees       Employee[]
  headCategories  HeadCategory[]
  offices         Office[]
  units           Unit[]
}

model Office {
  id            Int        @id
  office_name   String?    @db.VarChar(255)
  office_code   String?    @db.VarChar(50)
  office_status String     @default("A") @db.VarChar(50)
  divisionId    Int?
  employees     Employee[]
  division      Division?  @relation(fields: [divisionId], references: [id])
  units         Unit[]
}

model Unit {
  id          Int        @id
  unit_name   String?    @db.VarChar(255)
  unit_code   String?    @db.VarChar(50)
  unit_status String     @default("A") @db.VarChar(50)
  unit_type   String?    @db.VarChar(50)
  divisionId  Int?
  officeId    Int?
  employees   Employee[]
  division    Division?  @relation(fields: [divisionId], references: [id])
  office      Office?    @relation(fields: [officeId], references: [id])
}

model PositionGroup {
  id             Int            @id
  pos_group_name String         @db.VarChar(255)
  positioncodes  PositionCode[]
}

model PositionCode {
  id              Int            @id
  pos_code_name   String         @db.VarChar(255)
  pos_code_status String         @default("A") @db.VarChar(50)
  posgroupId      Int?
  positions       Position[]
  positiongroup   PositionGroup? @relation(fields: [posgroupId], references: [id])
}

model Position {
  id           Int           @id
  pos_name     String        @db.VarChar(255)
  pos_status   String        @default("A") @db.VarChar(50)
  poscodeId    Int?
  employees    Employee[]
  positioncode PositionCode? @relation(fields: [poscodeId], references: [id])
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(255)
  description String? @db.VarChar(255)
  users       User[]
}

model HeadCategory {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(255)
  description  String?
  departmentId Int
  divisionId   Int
  createdAt    DateTime     @default(now()) @db.Timestamptz(0)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(0)
  categories   Category[]
  department   Department   @relation(fields: [departmentId], references: [id])
  division     Division     @relation(fields: [divisionId], references: [id])
  typeDevices  TypeDevice[]
}

model Category {
  id             Int           @id @default(autoincrement())
  headCategoryId Int
  title          String        @db.VarChar(255)
  description    String?
  catIconId      Int?
  createdAt      DateTime      @default(now()) @db.Timestamptz(0)
  createdById    Int
  updatedAt      DateTime      @updatedAt @db.Timestamptz(0)
  catIcon        CategoryIcon? @relation(fields: [catIconId], references: [id])
  createdBy      User          @relation(fields: [createdById], references: [id])
  headCategory   HeadCategory  @relation(fields: [headCategoryId], references: [id])
  tickets        Ticket[]

  @@index([headCategoryId])
}

model Ticket {
  id               Int               @id @default(autoincrement())
  categoryId       Int
  title            String            @db.VarChar(255)
  description      String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(0)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(0)
  createdById      Int
  helpdeskRequests HelpdeskRequest[]
  category         Category          @relation(fields: [categoryId], references: [id])
  createdBy        User              @relation(fields: [createdById], references: [id])

  @@index([categoryId])
}

model TypeDevice {
  id               Int               @id @default(autoincrement())
  headCategoryId   Int
  name             String            @db.VarChar(255)
  createdAt        DateTime          @default(now()) @db.Timestamptz(0)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(0)
  createdById      Int
  brands           Brand[]
  helpdeskRequests HelpdeskRequest[]
  createdBy        User              @relation(fields: [createdById], references: [id])
  headCategory     HeadCategory      @relation(fields: [headCategoryId], references: [id])

  @@index([headCategoryId])
}

model Brand {
  id               Int               @id @default(autoincrement())
  typeDeviceId     Int
  name             String            @db.VarChar(255)
  createdAt        DateTime          @default(now()) @db.Timestamptz(0)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(0)
  createdById      Int
  createdBy        User              @relation(fields: [createdById], references: [id])
  typeDevice       TypeDevice        @relation(fields: [typeDeviceId], references: [id])
  helpdeskRequests HelpdeskRequest[]

  @@index([typeDeviceId])
}

model CategoryIcon {
  id         Int        @id @default(autoincrement())
  catIcon    String     @db.VarChar(255)
  categories Category[]
}

model Building {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(255)
  floors           Floor[]
  helpdeskRequests HelpdeskRequest[]
}

model Floor {
  id               Int               @id @default(autoincrement())
  buildingId       Int
  name             String            @db.VarChar(255)
  building         Building          @relation(fields: [buildingId], references: [id])
  helpdeskRequests HelpdeskRequest[]

  @@index([buildingId])
}

model Turning {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(255)
  helpdeskRequests HelpdeskRequest[]
}

model HelpdeskStatus {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(255)
  assignments      Assignment[]
  helpdeskRequests HelpdeskRequest[]
}

model Eliminate {
  id                Int             @id @default(autoincrement())
  helpdeskRequestId Int             @unique
  comment           String?
  eliminatefile     String?         @db.VarChar(255)
  createdAt         DateTime        @default(now()) @db.Timestamptz(0)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(0)
  createdById       Int
  createdBy         User            @relation(fields: [createdById], references: [id])
  helpdeskRequest   HelpdeskRequest @relation(fields: [helpdeskRequestId], references: [id])

  @@index([helpdeskRequestId])
  @@index([createdAt])
}

model HelpdeskRequest {
  id               Int            @id @default(autoincrement())
  ticketId         Int
  helpdeskStatusId Int            @default(1)
  buildingId       Int
  floorId          Int
  turningId        Int
  numberSKT        String?        @db.VarChar(255)
  telephone        String         @db.VarChar(50)
  details          String?
  hdFile           String?        @db.VarChar(255)
  priorityId       Int?
  createdById      Int
  createdAt        DateTime       @default(now()) @db.Timestamptz(0)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(0)
  room             String?        @db.VarChar(255)
  yearToyear       String?        @db.VarChar(255)
  yearUse          Int?
  brandId          Int?
  typeDeviceId     Int?
  assignments      Assignment[]
  chats            Chat[]
  eliminate        Eliminate?
  hdImgs           HelpdeskImg[]
  brand            Brand?         @relation(fields: [brandId], references: [id])
  building         Building       @relation(fields: [buildingId], references: [id])
  createdBy        User           @relation(fields: [createdById], references: [id])
  floor            Floor          @relation(fields: [floorId], references: [id])
  helpdeskStatus   HelpdeskStatus @relation(fields: [helpdeskStatusId], references: [id])
  priority         Priority?      @relation(fields: [priorityId], references: [id])
  ticket           Ticket         @relation(fields: [ticketId], references: [id])
  turning          Turning        @relation(fields: [turningId], references: [id])
  typeDevice       TypeDevice?    @relation(fields: [typeDeviceId], references: [id])
  notifications    Notification[]

  @@index([numberSKT])
  @@index([helpdeskStatusId])
  @@index([createdById])
  @@index([ticketId])
  @@index([createdAt])
}

model HelpdeskImg {
  id                Int             @id @default(autoincrement())
  helpdeskRequestId Int
  hdImg             String          @db.VarChar(255)
  helpdeskRequest   HelpdeskRequest @relation(fields: [helpdeskRequestId], references: [id])
}

model Priority {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(255)
  helpdeskRequests HelpdeskRequest[]
}

model Assignment {
  id                Int             @id @default(autoincrement())
  helpdeskRequestId Int
  assignedToId      Int
  assignedAt        DateTime        @default(now()) @db.Timestamptz(0)
  comment           String?
  commentImg        String?         @db.VarChar(255)
  helpdeskStatusId  Int?
  lat               Float?
  lng               Float?
  updatedAt         DateTime?       @updatedAt @db.Timestamptz(0)
  assignedTo        User            @relation(fields: [assignedToId], references: [id])
  helpdeskRequest   HelpdeskRequest @relation(fields: [helpdeskRequestId], references: [id])
  helpdeskStatus    HelpdeskStatus? @relation(fields: [helpdeskStatusId], references: [id])

  @@unique([helpdeskRequestId, assignedToId])
}

model Chat {
  id                Int             @id @default(autoincrement())
  helpdeskRequestId Int
  helpdeskRequest   HelpdeskRequest @relation(fields: [helpdeskRequestId], references: [id])
  senderId          Int
  sender            User            @relation(fields: [senderId], references: [id])
  message           String
  createdAt         DateTime        @default(now()) @db.Timestamptz(0)
  updatedAt         DateTime?       @updatedAt @db.Timestamptz(0)
  notifications     Notification[]

  @@index([helpdeskRequestId])
  @@index([senderId])
}

model Notification {
  id                Int             @id @default(autoincrement())
  userId            Int
  user              User            @relation(fields: [userId], references: [id])
  helpdeskRequestId Int
  helpdeskRequest   HelpdeskRequest @relation(fields: [helpdeskRequestId], references: [id])
  chatId            Int?
  chat              Chat?           @relation(fields: [chatId], references: [id])
  isRead            Boolean         @default(false)
  createdAt         DateTime        @default(now())

  @@index([userId])
  @@index([helpdeskRequestId])
}
